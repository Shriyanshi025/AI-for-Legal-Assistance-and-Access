# Application Configuration Environment Variables Example
# Copy this file to .env or .env.properties for local development

APP_ENVIRONMENT=development

# Gemini API Keys (obtain from Google AI Studio / GCP Console)
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# Supabase / PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=documents
